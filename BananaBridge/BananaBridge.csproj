<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <RootNamespace>BananaBridge</RootNamespace>
    <AssemblyName>BananaBridge</AssemblyName>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Description>Banana Editor plugin for Paint.NET</Description>
    <NoWarn>$(NoWarn);MSB3277;CS0618</NoWarn>
    <RollForward>Major</RollForward>
    <DisableDynamicDiscovery>true</DisableDynamicDiscovery>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Configurations>Debug;Release;DebugDesigner</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'DebugDesigner'">
    <DefineConstants>$(DefineConstants);DESIGNER_FALLBACK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PaintDotNet.Base">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>C:\Program Files\Paint.NET\PaintDotNet.Base.dll</HintPath>
    </Reference>
